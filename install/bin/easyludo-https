#!/usr/bin/env bash
# HTTPS auto-signé : Caddy écoute sur 443 (et redirige le port 80), puis relaie vers l'application.
#   easyludo-https             configure si besoin (idempotent) ; régénère le certificat si l'IP/le nom change ou s'il expire bientôt
#   easyludo-https --force     régénère le certificat dans tous les cas
#   easyludo-https --from-web  idem --force, lancé depuis l'interface (écrit son état pour la page Paramètres)
# Les navigateurs affichent un avertissement la première fois (certificat auto-signé) : « Avancé » → « Continuer ».
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
[ "$(id -u)" -eq 0 ] || { echo "À lancer en root."; exit 1; }

MODE="${1:-}"
TLS=/etc/easyludo/tls
DATA=/var/lib/easyludo/data
STATUS="$DATA/https-status.json"
FORCE=0; FINAL=0
case "$MODE" in --force|--from-web) FORCE=1;; esac

write_status() { # état message
  [ "$MODE" = "--from-web" ] || return 0
  local tmp; tmp=$(mktemp "$DATA/.https.XXXXXX")
  printf '{"state":"%s","message":"%s","at":"%s"}\n' "$1" "$2" "$(date -Is)" > "$tmp"
  chown easyludo:easyludo "$tmp"; chmod 644 "$tmp"; mv -f "$tmp" "$STATUS"
}
on_exit() { local rc=$?; if [ $rc -ne 0 ] && [ "$FINAL" -eq 0 ]; then write_status error "Échec de la configuration du HTTPS (voir le journal : journalctl -u easyludo-https)"; fi; }
trap on_exit EXIT

write_status running "Préparation…"
APP_PORT=$(sed -n 's/^PORT=//p' /etc/easyludo.env 2>/dev/null | tail -1)
APP_PORT=${APP_PORT:-3000}

if ! command -v caddy >/dev/null; then
  write_status running "Installation de Caddy (serveur HTTPS)…"
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq && apt-get install -y -qq caddy >/dev/null
fi
mkdir -p "$TLS"; chmod 755 /etc/easyludo "$TLS"

# Le certificat couvre le nom d'hôte et toutes les adresses IP actuelles du conteneur.
# "v2" = profil du certificat : le changer force la régénération.
write_status running "Génération du certificat…"
IPS=$(hostname -I | tr -s ' ' '\n' | grep -v '^$' | sort | tr '\n' ' ')
STAMP="v2|$(hostname)|$IPS"
EXPIRING=0
if [ -s "$TLS/cert.pem" ] && ! openssl x509 -checkend 2592000 -noout -in "$TLS/cert.pem" >/dev/null 2>&1; then EXPIRING=1; fi
if [ "$FORCE" -eq 1 ] || [ "$EXPIRING" -eq 1 ] || [ ! -s "$TLS/cert.pem" ] || [ "$(cat "$TLS/stamp" 2>/dev/null || true)" != "$STAMP" ]; then
  CNF=$(mktemp)
  {
    echo "[req]"; echo "distinguished_name=dn"; echo "x509_extensions=v3"; echo "prompt=no"
    echo "[dn]"; echo "CN=EasyLudo"
    # CA:TRUE : le certificat peut être installé comme « autorité de confiance » sur un téléphone ou un ordinateur
    echo "[v3]"; echo "basicConstraints=critical,CA:TRUE"; echo "keyUsage=digitalSignature,keyEncipherment,keyCertSign"; echo "extendedKeyUsage=serverAuth"
    echo "subjectAltName=@san"
    echo "[san]"
    n=1; echo "DNS.$n=$(hostname)"; n=$((n+1)); echo "DNS.$n=localhost"; n=$((n+1)); echo "DNS.$n=easyludo.local"
    i=1; echo "IP.$i=127.0.0.1"
    for ip in $IPS; do i=$((i+1)); echo "IP.$i=$ip"; done
  } > "$CNF"
  # 800 jours : au-delà de 825 jours, iOS refuse les certificats installés manuellement
  openssl req -x509 -newkey rsa:2048 -nodes -days 800 -sha256 -config "$CNF" \
    -keyout "$TLS/key.pem" -out "$TLS/cert.pem" 2>/dev/null
  rm -f "$CNF"
  echo "$STAMP" > "$TLS/stamp"
  echo "Certificat auto-signé généré pour : $(hostname) $IPS"
fi
chown root:caddy "$TLS/key.pem" "$TLS/cert.pem"; chmod 640 "$TLS/key.pem"; chmod 644 "$TLS/cert.pem"

write_status running "Configuration de Caddy…"
cat > /etc/caddy/Caddyfile <<CADDY
{
	admin off
	auto_https off
}

:80 {
	redir https://{host}{uri} permanent
}

:443 {
	tls $TLS/cert.pem $TLS/key.pem
	encode gzip
	reverse_proxy 127.0.0.1:$APP_PORT
}
CADDY

caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null
systemctl enable caddy >/dev/null 2>&1
systemctl restart caddy
sleep 1
systemctl is-active --quiet caddy || { journalctl -u caddy -n 15 --no-pager || true; exit 1; }
echo "HTTPS actif : https://$(hostname -I | awk '{print $1}')"
FINAL=1; write_status ok "HTTPS actif"
